// Configurable voltage op-amp — dominant-pole differential macromodel.
//
// Open-loop: H(s) = A0 / (1 + s/wp),  wp = 2*pi*GBW_HZ/A0_LINEAR
// CMRR: ACM(s) = Aol(s) / CMRR_LINEAR  (common-mode path)
// PSRR: H_ps(s) = (1/PSRR_LINEAR) / (1 + s/wp_psrr)  (VDD feedthrough)
// Noise: white_noise + flicker_noise on inp-inn (paper Fig. 2 pattern)
//
// Spectre notes:
// - laplace_nd coeffs must be refreshed each analog evaluation (not only initial_step).
// - Pass V(inp)-V(inn) directly into laplace_nd (not via intermediate reals).
// - Model Rout||Cout with external netlist passives; internal I(out) shunts break AC.

`include "constants.vams"
`include "disciplines.vams"

(* instance_parameter_list = {A0_DB, GBW_HZ, CMRR_DB, PSRR_DB, PSRR_POLE_HZ,
    RIN_OHM, CIN_F, ROUT_OHM, COUT_F, EN_WHITE_V_PER_SQRT_HZ,
    EN_FLICKER_1HZ_V_PER_SQRT_HZ, EN_FLICKER_EF, KF, AF, BIAS_CURRENT_A,
    ENABLE_NOISE} *)
module configurable_opamp(inp, inn, out, vdd, vss);

    input inp, inn, vdd, vss;
    electrical inp, inn, vdd, vss;
    output out;
    electrical out;

    parameter real A0_DB = 80.0;
    parameter real GBW_HZ = 10.0e6;
    parameter real FP2_HZ = 0.0;
    parameter real FZ_HZ = 0.0;
    parameter real CMRR_DB = 90.0;
    parameter real PSRR_DB = 80.0;
    parameter real PSRR_POLE_HZ = 100.0;
    parameter real RIN_OHM = 1.0e12;
    parameter real CIN_F = 1.0e-12;
    parameter real ROUT_OHM = 100.0;
    parameter real COUT_F = 2.0e-12;
    parameter real EN_WHITE_V_PER_SQRT_HZ = 0.0;
    parameter real EN_FLICKER_1HZ_V_PER_SQRT_HZ = 0.0;
    parameter real EN_FLICKER_EF = 1.0;
    parameter real KF = 0.0;
    parameter real AF = 1.0;
    parameter real BIAS_CURRENT_A = 1.0e-6;
    parameter real ENABLE_NOISE = 0.0;

    real a0_linear;
    real cmrr_linear;
    real psrr_linear;
    real wp;
    real wp_psrr;
    real rn_noise;
    real pn_flicker;
    real ir_bias;
    // Spectre laplace_nd requires array variables (not inline parameter expressions).
    real numer[0:1];
    real denom[0:1];
    real cm_numer[0:1];
    real cm_denom[0:1];
    real ps_numer[0:1];
    real ps_denom[0:1];

    analog begin
        a0_linear = pow(10.0, A0_DB / 20.0);
        if (a0_linear < 1.0)
            a0_linear = 1.0;
        cmrr_linear = pow(10.0, CMRR_DB / 20.0);
        if (cmrr_linear < 1.0)
            cmrr_linear = 1.0;
        psrr_linear = pow(10.0, PSRR_DB / 20.0);
        if (psrr_linear < 1.0)
            psrr_linear = 1.0;
        wp = 2.0 * `M_PI * GBW_HZ / a0_linear;
        wp_psrr = 2.0 * `M_PI * PSRR_POLE_HZ;
        if (wp_psrr < 1.0e-30)
            wp_psrr = 1.0e-30;
        // H(s) = (a0*wp) / (s + wp)  <=>  numer {a0*wp, 0}, denom {wp, 1}
        numer[0] = a0_linear * wp;
        numer[1] = 0.0;
        denom[0] = wp;
        denom[1] = 1.0;
        // ACM(s) = Aol(s) / CMRR_LINEAR
        cm_numer[0] = numer[0] / cmrr_linear;
        cm_numer[1] = 0.0;
        cm_denom[0] = wp;
        cm_denom[1] = 1.0;
        // H_ps(s) = (1/psrr_linear) / (1 + s/wp_psrr)
        ps_numer[0] = (1.0 / psrr_linear) * wp_psrr;
        ps_numer[1] = 0.0;
        ps_denom[0] = wp_psrr;
        ps_denom[1] = 1.0;

        // Pass branch potentials directly into laplace_nd; assigning to reals
        // first strips Spectre AC small-signal and yields zero gain in PSF.
        V(out) <+ laplace_nd(V(inp) - V(inn), numer, denom)
               + laplace_nd(0.5 * (V(inp) + V(inn)), cm_numer, cm_denom)
               + laplace_nd(V(vdd), ps_numer, ps_denom);

        // High-Z differential input conductance (optional loading).
        if (RIN_OHM > 0.0)
            I(inp, inn) <+ V(inp, inn) / RIN_OHM;
        if (CIN_F > 0.0)
            I(inp, inn) <+ CIN_F * ddt(V(inp, inn));

        // Output shunt (Rout || Cout) — modeled externally in Spectre/SPICE netlists;
        // an internal I(out) shunt here breaks Spectre AC with laplace_nd.

        // Input-referred noise (Coram-corrected flicker + thermal, paper Fig. 2).
        if (ENABLE_NOISE != 0.0) begin
            rn_noise = 1.0e-30;
            if (EN_WHITE_V_PER_SQRT_HZ > 0.0) begin
                rn_noise = (EN_WHITE_V_PER_SQRT_HZ * EN_WHITE_V_PER_SQRT_HZ)
                         / (4.0 * `P_K * $temperature);
                if (rn_noise < 1.0e-30)
                    rn_noise = 1.0e-30;
                I(inp, inn) <+ white_noise(4.0 * `P_K * $temperature / rn_noise, "thermal");
            end
            // Flicker on I(inp,inn) only (Spectre rejects V+I noise on same branch).
            pn_flicker = 0.0;
            if (EN_FLICKER_1HZ_V_PER_SQRT_HZ > 0.0) begin
                pn_flicker = EN_FLICKER_1HZ_V_PER_SQRT_HZ
                           * EN_FLICKER_1HZ_V_PER_SQRT_HZ;
                if (RIN_OHM > 0.0)
                    I(inp, inn) <+ flicker_noise(pn_flicker / (RIN_OHM * RIN_OHM),
                                                  EN_FLICKER_EF, "flicker");
            end else if (KF > 0.0 && abs(BIAS_CURRENT_A) > 0.0) begin
                pn_flicker = KF * pow(abs(BIAS_CURRENT_A), AF);
                ir_bias = BIAS_CURRENT_A;
                if (ir_bias >= 0.0)
                    I(inp, inn) <+ flicker_noise(pn_flicker, EN_FLICKER_EF, "flicker");
                else
                    I(inp, inn) <+ flicker_noise(-pn_flicker, EN_FLICKER_EF, "flicker");
            end
        end
    end

endmodule
